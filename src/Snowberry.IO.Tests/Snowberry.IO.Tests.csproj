<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net10.0;net48</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<IsPackable>false</IsPackable>
		<Platforms>AnyCPU</Platforms>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="coverlet.MTP" />
		<PackageReference Include="AwesomeAssertions" />
		<PackageReference Include="TngTech.ArchUnitNET" />
		<PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
		<PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Snowberry.IO.Common\Snowberry.IO.Common.csproj" />
		<ProjectReference Include="..\Snowberry.IO\Snowberry.IO.csproj" />
	</ItemGroup>

	<!-- Snowberry.IO.SingleFile does not target .NET Framework, so its tests only run on the .NET targets. -->
	<ItemGroup Condition="'$(TargetFramework)' != 'net48'">
		<ProjectReference Include="..\Snowberry.IO.SingleFile\Snowberry.IO.SingleFile.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<Compile Remove="SingleFile\**\*.cs" />
		<Compile Remove="Infrastructure\SingleFile\**\*.cs" />
		<Compile Remove="Architecture\SingleFileArchitectureTests.cs" />
	</ItemGroup>

</Project>
