<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../NuGetPackage.props" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <Description>Reads, extracts and modifies the bundles of single-file published .NET applications.</Description>
        <PackageTags>single-file single-file-publish bundle apphost dotnet</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Snowberry.IO.Tests" Key="" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Snowberry.IO\Snowberry.IO.csproj" />
    </ItemGroup>
</Project>
